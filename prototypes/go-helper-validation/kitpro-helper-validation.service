[Unit]
Description=Disposable KITPro Go helper validation service
After=docker.service
Requires=docker.service
Requires=kitpro-helper-validation.socket
After=kitpro-helper-validation.socket

[Service]
Type=simple
User=root
Group=root
Environment=KITPRO_TEST_SOCKET=/run/kitpro/helper.sock
Environment=KITPRO_TEST_DB=/var/lib/kitpro-helper/production-gate.db
Environment=KITPRO_TEST_ROOT=/srv/kitpro/validation
Environment=KITPRO_TEST_ALLOWED_UID=987
ExecStart=/usr/libexec/kitpro-helper-validation
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/run/kitpro /var/lib/kitpro-helper /var/log/kitpro /srv/kitpro /srv/kitpro/validation /var/run/docker.sock

[Install]
WantedBy=multi-user.target
