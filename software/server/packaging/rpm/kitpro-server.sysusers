u kitpro-api - "KITPro Server API" /var/lib/kitpro-api /usr/sbin/nologin
g kitpro-api -
m kitpro-api kitpro-api
u kitpro-ingress - "KITPro managed ingress" /nonexistent /usr/sbin/nologin
g kitpro-ingress -
m kitpro-ingress kitpro-ingress
u kitpro-cloudflared - "KITPro Cloudflare Tunnel runtime" /nonexistent /usr/sbin/nologin
g kitpro-cloudflared -
m kitpro-cloudflared kitpro-cloudflared
