/srv/kitpro/apps(/.*)?    gen_context(system_u:object_r:container_file_t,s0)
/var/lib/kitpro-helper/ingress/logs(/.*)?    gen_context(system_u:object_r:httpd_log_t,s0)
/var/lib/kitpro-helper/ingress/run/nginx\.pid    --    gen_context(system_u:object_r:kitpro_ingress_pid_t,s0)
/usr/libexec/kitpro-acme    --    gen_context(system_u:object_r:kitpro_acme_exec_t,s0)
/var/lib/kitpro-helper/acme(/.*)?    gen_context(system_u:object_r:kitpro_acme_state_t,s0)
/run/kitpro/acme-client\.sock    -s    gen_context(system_u:object_r:kitpro_acme_runtime_t,s0)
/run/kitpro-ingress/acme\.sock    -s    gen_context(system_u:object_r:kitpro_acme_runtime_t,s0)
/usr/libexec/kitpro-cloudflare    --    gen_context(system_u:object_r:kitpro_cloudflare_exec_t,s0)
/var/lib/kitpro-helper/providers/cloudflare(/.*)?    gen_context(system_u:object_r:kitpro_cloudflare_state_t,s0)
/run/kitpro/cloudflare\.sock    -s    gen_context(system_u:object_r:kitpro_cloudflare_runtime_t,s0)
