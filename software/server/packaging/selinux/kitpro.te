policy_module(kitpro, 1.2.0)

# KITPro-managed application data uses the standard container file type. Each
# private mount receives an MCS label from Podman's :Z handling at runtime.
gen_require(`
    type container_file_t;
    type httpd_t;
    type var_run_t;
    attribute unreserved_port_type;
')

type kitpro_acme_t;
type kitpro_acme_exec_t;
init_daemon_domain(kitpro_acme_t, kitpro_acme_exec_t)
init_nnp_daemon_domain(kitpro_acme_t)

type kitpro_acme_state_t;
files_type(kitpro_acme_state_t)

type kitpro_acme_runtime_t;
files_type(kitpro_acme_runtime_t)

manage_dirs_pattern(kitpro_acme_t, kitpro_acme_state_t, kitpro_acme_state_t)
manage_files_pattern(kitpro_acme_t, kitpro_acme_state_t, kitpro_acme_state_t)
manage_sock_files_pattern(kitpro_acme_t, var_run_t, kitpro_acme_runtime_t)
files_pid_filetrans(kitpro_acme_t, kitpro_acme_runtime_t, sock_file, "acme-client.sock")
files_pid_filetrans(kitpro_acme_t, kitpro_acme_runtime_t, sock_file, "acme.sock")

files_search_var_lib(kitpro_acme_t)
files_search_pids(kitpro_acme_t)
auth_read_passwd(kitpro_acme_t)
miscfiles_read_generic_certs(kitpro_acme_t)
sysnet_dns_name_resolve(kitpro_acme_t)
corenet_tcp_connect_http_port(kitpro_acme_t)
corenet_tcp_connect_http_cache_port(kitpro_acme_t)
allow kitpro_acme_t self:capability chown;

files_search_pids(httpd_t)
allow httpd_t kitpro_acme_runtime_t:sock_file { getattr open read write };
allow httpd_t kitpro_acme_t:unix_stream_socket connectto;

type kitpro_cloudflare_t;
type kitpro_cloudflare_exec_t;
init_daemon_domain(kitpro_cloudflare_t, kitpro_cloudflare_exec_t)
init_nnp_daemon_domain(kitpro_cloudflare_t)

type kitpro_cloudflare_state_t;
files_type(kitpro_cloudflare_state_t)

type kitpro_cloudflare_runtime_t;
files_type(kitpro_cloudflare_runtime_t)

manage_dirs_pattern(kitpro_cloudflare_t, kitpro_cloudflare_state_t, kitpro_cloudflare_state_t)
manage_files_pattern(kitpro_cloudflare_t, kitpro_cloudflare_state_t, kitpro_cloudflare_state_t)
manage_sock_files_pattern(kitpro_cloudflare_t, var_run_t, kitpro_cloudflare_runtime_t)
files_pid_filetrans(kitpro_cloudflare_t, kitpro_cloudflare_runtime_t, sock_file, "cloudflare.sock")

files_search_var_lib(kitpro_cloudflare_t)
files_search_pids(kitpro_cloudflare_t)
auth_read_passwd(kitpro_cloudflare_t)
miscfiles_read_generic_certs(kitpro_cloudflare_t)
sysnet_dns_name_resolve(kitpro_cloudflare_t)
corenet_tcp_connect_http_port(kitpro_cloudflare_t)
corenet_tcp_connect_all_unreserved_ports(kitpro_cloudflare_t)
corenet_udp_bind_generic_node(kitpro_cloudflare_t)
allow kitpro_cloudflare_t unreserved_port_type:udp_socket { recv_msg send_msg };
corecmd_exec_bin(kitpro_cloudflare_t)
allow kitpro_cloudflare_t self:capability { setgid setuid };
