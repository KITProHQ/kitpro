# KITPro Server production helper profile.
#include <tunables/global>
/usr/libexec/kitpro-helper flags=(attach_disconnected) {
  #include <abstractions/base>
  /usr/libexec/kitpro-helper rix,
  capability chown,
  capability dac_read_search,
  /etc/passwd r,
  /run/kitpro/** rw,
  /var/lib/kitpro-helper/ rw,
  /var/lib/kitpro-helper/** rwk,
  # backup.Vacuum atomically publishes a verified helper upgrade backup by
  # hard-linking its private temporary file to the final name in the same
  # root-owned directory. Debian uses a paired staging directory; Arch's
  # installed hook writes directly in backups. No other helper path gains link
  # authority.
  link subset /var/lib/kitpro-helper/backups/.kitpro-upgrade-*.partial/pre-upgrade-helper-to-*.db -> /var/lib/kitpro-helper/backups/.kitpro-upgrade-*.partial/.pre-upgrade-helper-to-*.db.partial-*,
  link subset /var/lib/kitpro-helper/backups/pre-upgrade-helper-to-*.db -> /var/lib/kitpro-helper/backups/.pre-upgrade-helper-to-*.db.partial-*,
  /srv/kitpro/** rwk,
  # Directory metadata only. The helper validates registered roots but never
  # reads imported content; Docker performs the constrained bind mount.
  /mnt/ r,
  /mnt/**/ r,
  /media/ r,
  /media/**/ r,
  /data/ r,
  /data/**/ r,
  /srv/ r,
  /srv/**/ r,
  /var/run/docker.sock rw,
  /run/docker.sock rw,
  /proc/** r,
  /sys/** r,
  deny /bin/** x,
  deny /usr/bin/** x,
  deny /home/** r,
  deny /root/** r,
  deny network inet,
  deny network inet6,
}
