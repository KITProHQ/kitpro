[Unit]
Description=KITPro Server privileged helper
Documentation=man:kitpro-helper(8)
Requires=kitpro-helper.socket
After=docker.service

[Service]
Type=simple
AppArmorProfile=/usr/libexec/kitpro-helper
ExecStart=/usr/libexec/kitpro-helper
User=root
Group=root
EnvironmentFile=-/etc/default/kitpro-server
EnvironmentFile=-/etc/conf.d/kitpro-server
Environment=KITPRO_API_USER=kitpro-api
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
BindReadOnlyPaths=-/dev/disk
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
# CAP_CHOWN preserves manifest-declared ownership in KITPro-managed storage.
# CAP_DAC_READ_SEARCH lets the root helper read application-owned backup data
# without granting write bypass. Imported roots are never copied or re-owned.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_CHOWN CAP_DAC_READ_SEARCH
UMask=0077
ReadWritePaths=/run/kitpro /run/kitpro-ingress /run/systemd/system /var/lib/kitpro-helper /srv/kitpro /var/log/kitpro /etc/systemd/system /etc/systemd/network
Restart=on-failure

[Install]
WantedBy=multi-user.target
