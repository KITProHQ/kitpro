[Unit]
Description=KITPro bounded nginx configuration validator
After=local-fs.target
Before=kitpro-helper.service

[Service]
Type=simple
AppArmorProfile=/usr/libexec/kitpro-ingress-validator
ExecStart=/usr/libexec/kitpro-ingress-validator
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadWritePaths=/run/kitpro /var/lib/kitpro-helper/ingress
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target
