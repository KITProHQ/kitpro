{
  "schema_version": 7,
  "id": "navidrome",
  "name": "Navidrome",
  "description": "Stream a music library while keeping source audio read only.",
  "category": "Music",
  "kind": "application",
  "catalog_status": "standard",
  "website_url": "https://www.navidrome.org/",
  "source_url": "https://github.com/navidrome/navidrome",
  "documentation_url": "https://www.navidrome.org/docs/",
  "releases": [
    {"version": "0.64.0", "registry": "docker.io", "repository": "deluan/navidrome", "digest": "sha256:1a64cbb2603cec5d2615c3a27e91442436b2229583408a55cdc8d85705b95e65", "platform": "linux/amd64"}
  ],
  "run_as": {"uid": 1000, "gid": 1000},
  "storage": [
    {"id": "data", "container_path": "/data", "persistent": true, "read_only": false, "owner_uid": 1000, "owner_gid": 1000}
  ],
  "external_storage": [
    {"id": "music", "container_path": "/music", "mode": "read-only", "required": true, "purpose": "Music library"}
  ],
  "environment": [
    {"name": "ND_LOGLEVEL", "value": "info"},
    {"name": "ND_SCANSCHEDULE", "value": "1h"}
  ],
  "services": [
    {"id": "web", "name": "Web Interface", "protocol": "http", "container_port": 4533}
  ],
  "restart": "unless-stopped",
  "backup": {"strategy": "cold-sqlite-filesystem", "storage": [{"component": "app", "id": "data", "disposition": "include"}]}
}
