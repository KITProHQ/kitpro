{
  "schema_version": 6,
  "id": "ollama",
  "name": "Ollama",
  "description": "Run local language models with CPU support and optional trusted GPU acceleration.",
  "releases": [
    {"version": "0.34.0", "registry": "docker.io", "repository": "ollama/ollama", "digest": "sha256:aa6f86f01fee264c81f1edd9083ebfb07c8116d95d8bedd1ad470874b66a40b4", "platform": "linux/amd64"}
  ],
  "storage": [
    {"id": "models", "container_path": "/root/.ollama", "persistent": true, "read_only": false}
  ],
  "services": [
    {"id": "api", "name": "Ollama API", "protocol": "http", "container_port": 11434}
  ],
  "hardware": [
    {"class": "gpu.nvidia", "optional": true, "cpu_fallback": true}
  ],
  "restart": "unless-stopped",
  "backup": {"strategy": "cold-filesystem", "storage": [{"component": "app", "id": "models", "disposition": "include"}]}
}
