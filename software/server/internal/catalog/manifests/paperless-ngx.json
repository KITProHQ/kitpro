{
  "schema_version": 6,
  "id": "paperless-ngx",
  "name": "Paperless-ngx",
  "description": "Document management with a web application and internal Redis broker.",
  "releases": [
    {"version": "2.20.15", "registry": "docker.io", "repository": "paperlessngx/paperless-ngx", "digest": "sha256:6c86cad803970ea782683a8e80e7403444c5bf3cf70de63b4d3c8e87500db92f", "platform": "linux/amd64"},
    {"version": "redis-7.4.11", "registry": "docker.io", "repository": "library/redis", "digest": "sha256:71da9275c5f3fcb97d0fa0c8c5b36cc995327265420f17a04bfd544f458059f7", "platform": "linux/amd64"}
  ],
  "services": [
    {"id": "web", "name": "Web Interface", "protocol": "http", "container_port": 8000}
  ],
  "restart": "unless-stopped",
  "components": [
    {"id": "broker", "release": "redis-7.4.11", "storage": [{"id": "data", "container_path": "/data", "persistent": true, "read_only": false}], "services": [{"id": "redis", "name": "Redis", "protocol": "tcp", "container_port": 6379}], "restart": "unless-stopped"},
    {"id": "web", "release": "2.20.15", "environment": [{"name": "PAPERLESS_REDIS", "value": "redis://broker:6379"}], "storage": [{"id": "data", "container_path": "/usr/src/paperless/data", "persistent": true, "read_only": false}, {"id": "media", "container_path": "/usr/src/paperless/media", "persistent": true, "read_only": false}, {"id": "consume", "container_path": "/usr/src/paperless/consume", "persistent": true, "read_only": false}, {"id": "export", "container_path": "/usr/src/paperless/export", "persistent": true, "read_only": false}], "services": [{"id": "web", "name": "Web Interface", "protocol": "http", "container_port": 8000}], "depends_on": ["broker"], "restart": "unless-stopped"}
  ],
  "backup": {"strategy": "cold-sqlite-filesystem", "storage": [{"component": "broker", "id": "data", "disposition": "exclude-ephemeral"}, {"component": "web", "id": "data", "disposition": "include"}, {"component": "web", "id": "media", "disposition": "include"}, {"component": "web", "id": "consume", "disposition": "include"}, {"component": "web", "id": "export", "disposition": "include"}]}
}
