{
  "schema_version": 7,
  "id": "forgejo",
  "name": "Forgejo",
  "description": "A self-hosted Git service for repositories, collaboration, and project management.",
  "category": "Developer Tools",
  "kind": "application",
  "catalog_status": "standard",
  "website_url": "https://forgejo.org/",
  "source_url": "https://codeberg.org/forgejo/forgejo",
  "documentation_url": "https://forgejo.org/docs/latest/",
  "limitations": [
    "Git-over-SSH is not exposed in this initial KITPro profile; use Git over HTTP.",
    "This initial profile uses SQLite and has no external database component.",
    "Public Internet publishing and HTTPS are outside this application integration."
  ],
  "releases": [{
    "version": "16.0.5",
    "registry": "codeberg.org",
    "repository": "forgejo/forgejo",
    "digest": "sha256:523de0217475297d05786d7551c1c1d6b5c8b90d6fee7189e88a234260ec0e74",
    "platform": "linux/amd64"
  }],
  "storage": [{
    "id": "data",
    "container_path": "/data",
    "persistent": true,
    "read_only": false,
    "owner_uid": 1000,
    "owner_gid": 1000
  }],
  "environment": [
    {"name": "USER_UID", "value": "1000"},
    {"name": "USER_GID", "value": "1000"}
  ],
  "services": [{"id": "web", "name": "Web Interface", "protocol": "http", "container_port": 3000}],
  "restart": "unless-stopped",
  "backup": {"strategy": "cold-sqlite-filesystem", "storage": [{"component": "app", "id": "data", "disposition": "include"}]}
}
